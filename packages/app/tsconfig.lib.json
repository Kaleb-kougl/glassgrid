{
  // The app: browser-only. No Node typings, so Node APIs fail to typecheck;
  // Electron is never imported here (ESLint boundary rule).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["src"]
}

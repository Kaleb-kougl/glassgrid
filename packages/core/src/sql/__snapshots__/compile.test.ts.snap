exports[`compileChartQuery snapshots > bar: sum with colour, top 5, filtered 1`] = `
"WITH __gg_base AS (
  SELECT "we""ird name" AS gx, "amount" AS gy, "select" AS gc
  FROM "v_sales"
  WHERE ("qty" >= CAST($1 AS DOUBLE) AND "qty" <= CAST($2 AS DOUBLE))
),
__gg_series AS (
  SELECT gc, CAST(sum(gy) AS DOUBLE) AS v, TRUE AS k FROM __gg_base GROUP BY gc
  ORDER BY v DESC NULLS LAST, gc ASC NULLS LAST LIMIT 8
),
__gg_src AS (
  SELECT b.* EXCLUDE (gc), CASE WHEN s.k THEN b.gc END AS gc, s.k IS NULL AS other
  FROM __gg_base AS b LEFT JOIN __gg_series AS s ON b.gc IS NOT DISTINCT FROM s.gc
),
__gg_top AS (
  SELECT gx, CAST(sum(gy) AS DOUBLE) AS v FROM __gg_base GROUP BY gx
  ORDER BY v DESC NULLS LAST, gx ASC NULLS LAST LIMIT CAST($3 AS BIGINT)
)
SELECT s.gx AS x, s.gc AS color, s.other AS color_other, CAST(sum(s.gy) AS DOUBLE) AS y
FROM __gg_src AS s JOIN __gg_top AS t ON s.gx IS NOT DISTINCT FROM t.gx
GROUP BY s.gx, s.gc, s.other, t.v
ORDER BY t.v DESC NULLS LAST, s.gx ASC NULLS LAST, s.other ASC, s.gc ASC NULLS LAST"
`;


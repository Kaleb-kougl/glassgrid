// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compileChartQuery snapshots > area: colour series with M4 1`] = `
"WITH __gg_base AS (
  SELECT date_trunc('month', "created_on") AS gx, "category" AS gc
  FROM "v_sales"
  WHERE "created_on" IS NOT NULL
),
__gg_series AS (
  SELECT gc, CAST(count(*) AS DOUBLE) AS v, TRUE AS k FROM __gg_base GROUP BY gc
  ORDER BY v DESC NULLS LAST, gc ASC NULLS LAST LIMIT 8
),
__gg_src AS (
  SELECT b.* EXCLUDE (gc), CASE WHEN s.k THEN b.gc END AS gc, s.k IS NULL AS other
  FROM __gg_base AS b LEFT JOIN __gg_series AS s ON b.gc IS NOT DISTINCT FROM s.gc
),
__gg_agg AS (
  SELECT gx AS x, gc AS color, other AS color_other, CAST(count(*) AS DOUBLE) AS y
  FROM __gg_src GROUP BY gx, gc, other
),
__gg_xn AS (SELECT *, epoch_us(x) AS xn FROM __gg_agg),
__gg_px AS (
  SELECT a.*, CASE WHEN b.hi = b.lo THEN 0 ELSE least(floor((a.xn - b.lo) / (b.hi - b.lo) * CAST($1 AS DOUBLE)), CAST($1 AS DOUBLE) - 1) END AS px
  FROM __gg_xn AS a CROSS JOIN (SELECT min(xn) AS lo, max(xn) AS hi FROM __gg_xn) AS b
),
__gg_m4 AS (
  SELECT *,
    row_number() OVER (PARTITION BY color, color_other, px ORDER BY x ASC) AS r_first,
    row_number() OVER (PARTITION BY color, color_other, px ORDER BY x DESC) AS r_last,
    row_number() OVER (PARTITION BY color, color_other, px ORDER BY y ASC NULLS LAST, x ASC) AS r_min,
    row_number() OVER (PARTITION BY color, color_other, px ORDER BY y DESC NULLS LAST, x ASC) AS r_max
  FROM __gg_px
)
SELECT x, y, color, color_other
FROM __gg_m4
WHERE r_first = 1 OR r_last = 1 OR r_min = 1 OR r_max = 1
ORDER BY color_other ASC, color ASC NULLS LAST, x"
`;

exports[`compileChartQuery snapshots > area: colour series with M4 2`] = `
[
  1000,
]
`;

exports[`compileChartQuery snapshots > bar: count by category 1`] = `
"WITH __gg_base AS (
  SELECT "category" AS gx
  FROM "v_sales"
)
SELECT gx AS x, CAST(count(*) AS DOUBLE) AS y
FROM __gg_base
GROUP BY gx
ORDER BY y DESC NULLS LAST, gx ASC NULLS LAST
LIMIT CAST($1 AS BIGINT)"
`;


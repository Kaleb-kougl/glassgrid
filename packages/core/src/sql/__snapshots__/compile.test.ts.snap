]
`;

exports[`compileChartQuery snapshots > heatmap: numeric x time 1`] = `
"WITH __gg_base AS (
  SELECT floor(CAST("amount" AS DOUBLE) / CAST($1 AS DOUBLE)) AS gx, date_trunc('hour', "ts") AS gy
  FROM "v_sales"
  WHERE "amount" IS NOT NULL
    AND "ts" IS NOT NULL
)
SELECT gx * CAST($1 AS DOUBLE) AS x, (gx + 1) * CAST($1 AS DOUBLE) AS x_end, gy AS y, gy + INTERVAL 1 HOUR AS y_end, CAST(count(*) AS DOUBLE) AS count
FROM __gg_base
GROUP BY gx, gy
ORDER BY gx, gy"
`;


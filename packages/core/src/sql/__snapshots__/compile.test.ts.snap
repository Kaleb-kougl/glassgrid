exports[`compileChartQuery: integer time keys and the combined heatmap cell key > heatmap: numeric x numeric (one cell key) 1`] = `
"WITH __gg_base AS (
  SELECT floor(CAST("amount" AS DOUBLE) / CAST($1 AS DOUBLE)) * 67108864 + floor(CAST("qty" AS DOUBLE) / CAST($2 AS DOUBLE)) AS gxy
  FROM "v_sales"
  WHERE "amount" IS NOT NULL
    AND "qty" IS NOT NULL
),
__gg_cells AS (
  SELECT round(gxy / 67108864) AS gx, gxy - round(gxy / 67108864) * 67108864 AS gy, CAST(count(*) AS DOUBLE) AS n
  FROM __gg_base GROUP BY gxy
)
SELECT gx * CAST($1 AS DOUBLE) AS x, (gx + 1) * CAST($1 AS DOUBLE) AS x_end, gy * CAST($2 AS DOUBLE) AS y, (gy + 1) * CAST($2 AS DOUBLE) AS y_end, n AS count
FROM __gg_cells
ORDER BY gx, gy"
`;

exports[`compileChartQuery: integer time keys and the combined heatmap cell key > heatmap: numeric x numeric (one cell key) 2`] = `
[
  20,
  1,
]
`;

exports[`compileChartQuery: integer time keys and the combined heatmap cell key > histogram: hourly TIMESTAMP 1`] = `
"WITH __gg_base AS (
  SELECT CASE WHEN epoch_us("ts") >= 0 THEN epoch_us("ts") // 3600000000 ELSE coalesce((epoch_us("ts") + 1) // 3600000000 - 1, CASE WHEN "ts" > TIMESTAMP '1970-01-01' THEN 9223372036854775807 WHEN "ts" < TIMESTAMP '1970-01-01' THEN -9223372036854775807 END) END AS gx
  FROM "v_sales"
  WHERE "ts" IS NOT NULL
)
SELECT CASE WHEN gx = 9223372036854775807 THEN CAST('infinity' AS TIMESTAMP) WHEN gx = -9223372036854775807 THEN CAST('-infinity' AS TIMESTAMP) ELSE make_timestamp(gx * 3600000000) END AS x, (CASE WHEN gx = 9223372036854775807 THEN CAST('infinity' AS TIMESTAMP) WHEN gx = -9223372036854775807 THEN CAST('-infinity' AS TIMESTAMP) ELSE make_timestamp(gx * 3600000000) END) + INTERVAL 1 HOUR AS x_end, CAST(count(*) AS DOUBLE) AS y
FROM __gg_base
GROUP BY gx
ORDER BY gx"
`;


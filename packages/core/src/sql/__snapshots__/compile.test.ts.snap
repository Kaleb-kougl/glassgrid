exports[`compileChartQuery snapshots > histogram: explicit width, avg, colour 1`] = `
"WITH __gg_base AS (
  SELECT floor(CAST("qty" AS DOUBLE) / CAST($1 AS DOUBLE)) AS gx, "price" AS gy, "active" AS gc
  FROM "v_sales"
  WHERE "qty" IS NOT NULL
),
__gg_series AS (
  SELECT gc, CAST(avg(gy) AS DOUBLE) AS v, TRUE AS k FROM __gg_base GROUP BY gc
  ORDER BY v DESC NULLS LAST, gc ASC NULLS LAST LIMIT 8
),
__gg_src AS (
  SELECT b.* EXCLUDE (gc), CASE WHEN s.k THEN b.gc END AS gc, s.k IS NULL AS other
  FROM __gg_base AS b LEFT JOIN __gg_series AS s ON b.gc IS NOT DISTINCT FROM s.gc
)
SELECT gx * CAST($1 AS DOUBLE) AS x, (gx + 1) * CAST($1 AS DOUBLE) AS x_end, gc AS color, other AS color_other, CAST(avg(gy) AS DOUBLE) AS y
FROM __gg_src
GROUP BY gx, gc, other
ORDER BY gx, other ASC, gc ASC NULLS LAST"
`;


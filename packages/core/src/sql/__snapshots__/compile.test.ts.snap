exports[`compileChartQuery snapshots > line: numeric x, explicit bin 1`] = `
"WITH __gg_base AS (
  SELECT floor(CAST("price" AS DOUBLE) / CAST($1 AS DOUBLE)) AS gx, "qty" AS gy
  FROM "v_sales"
  WHERE "price" IS NOT NULL
),
__gg_agg AS (
  SELECT gx * CAST($1 AS DOUBLE) AS x, CAST(max(gy) AS DOUBLE) AS y
  FROM __gg_base GROUP BY gx
),
__gg_xn AS (SELECT *, CAST(x AS DOUBLE) AS xn FROM __gg_agg),
__gg_px AS (
  SELECT a.*, CASE WHEN b.hi = b.lo THEN 0 ELSE least(floor((a.xn - b.lo) / (b.hi - b.lo) * CAST($2 AS DOUBLE)), CAST($2 AS DOUBLE) - 1) END AS px
  FROM __gg_xn AS a CROSS JOIN (SELECT min(xn) AS lo, max(xn) AS hi FROM __gg_xn) AS b
),
__gg_m4 AS (
  SELECT *,
    row_number() OVER (PARTITION BY px ORDER BY x ASC) AS r_first,
    row_number() OVER (PARTITION BY px ORDER BY x DESC) AS r_last,
    row_number() OVER (PARTITION BY px ORDER BY y ASC NULLS LAST, x ASC) AS r_min,
    row_number() OVER (PARTITION BY px ORDER BY y DESC NULLS LAST, x ASC) AS r_max
  FROM __gg_px
)
SELECT x, y
FROM __gg_m4
WHERE r_first = 1 OR r_last = 1 OR r_min = 1 OR r_max = 1
ORDER BY x"
`;


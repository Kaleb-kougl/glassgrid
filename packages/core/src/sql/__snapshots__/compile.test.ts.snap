`;

exports[`compileRowsQuery / compileCountQuery > selects every column, sorts with a full tiebreak and pages with parameters 1`] = `
"SELECT "category", "amount", "qty", "price", "created_on", "ts", "active", "we""ird name", "select", "日付 😀"
FROM "v_sales"
WHERE "category" IS NOT NULL
ORDER BY "amount" DESC NULLS LAST, "we""ird name" ASC NULLS LAST, "category" ASC NULLS LAST, "qty" ASC NULLS LAST, "price" ASC NULLS LAST, "created_on" ASC NULLS LAST, "ts" ASC NULLS LAST, "active" ASC NULLS LAST, "select" ASC NULLS LAST, "日付 😀" ASC NULLS LAST
LIMIT CAST($1 AS BIGINT) OFFSET CAST($2 AS BIGINT)"
`;

exports[`compileWhere > compiles every filter kind with bound, cast parameters 1`] = `"("amount" >= CAST($1 AS DOUBLE) AND "amount" < CAST($2 AS DOUBLE)) AND "ts" > CAST($3 AS TIMESTAMP) AND "created_on" <= epoch_ms(CAST($4 AS BIGINT)) AND ("category" IN (CAST($5 AS VARCHAR), CAST($6 AS VARCHAR)) OR "category" IS NULL) AND "active" IN (CAST($7 AS BOOLEAN)) AND FALSE AND "we""ird name" IS NULL AND "price" IS NULL AND "select" IS NOT NULL"`;

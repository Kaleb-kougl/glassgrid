]
`;

exports[`compileChartQuery snapshots > bar: max date per month 1`] = `
"WITH __gg_base AS (
  SELECT date_trunc('month', "ts") AS gx, "created_on" AS gy
  FROM "v_sales"
)
SELECT gx AS x, max(gy) AS y
FROM __gg_base
GROUP BY gx
ORDER BY y DESC NULLS LAST, gx ASC NULLS LAST
LIMIT CAST($1 AS BIGINT)"
`;


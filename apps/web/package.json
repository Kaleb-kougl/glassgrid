{
  "name": "@glassgrid/web",
  "version": "0.0.0",
  "private": true,
  "description": "Glassgrid in the browser: the shared app (@glassgrid/app) on the web platform with DuckDB-WASM (@glassgrid/engine/web) in a Web Worker, the sample workspaces, and the component gallery at /gallery.",
  "license": "MIT",
  "author": "Kaleb Kougl",
  "homepage": "https://github.com/Kaleb-kougl/glassgrid#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kaleb-kougl/glassgrid.git",
    "directory": "apps/web"
  },
  "bugs": {
    "url": "https://github.com/Kaleb-kougl/glassgrid/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "size": "vite build && node scripts/size.ts",
    "e2e": "vite build && playwright test",
    "hosting": "node scripts/write-vercel-json.ts"
  },
  "dependencies": {
    "@glassgrid/app": "workspace:*",
    "@glassgrid/core": "workspace:*",
    "@glassgrid/engine": "workspace:*",
    "@glassgrid/ui": "workspace:*",
    "apache-arrow": "21.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.1",
    "path-to-regexp": "6.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}

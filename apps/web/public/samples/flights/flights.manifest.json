  "query": {
    "day": "SELECT CAST(epoch_ms(ts) AS TIMESTAMP_MS) AS ts, hex, flight, registration, \"typeCode\", CAST(lat AS DECIMAL(7, 5)) AS lat, CAST(lon AS DECIMAL(8, 5)) AS lon, CAST(round(\"altBaroFt\") AS INTEGER) AS \"altBaroFt\", CAST(round(\"altGeomFt\") AS INTEGER) AS \"altGeomFt\", \"onGround\", round(\"gsKt\", 1) AS \"gsKt\", round(\"trackDeg\", 1) % 360 AS \"trackDeg\", CAST(round(\"baroRateFpm\") AS INTEGER) AS \"baroRateFpm\", CAST(round(\"geomRateFpm\") AS INTEGER) AS \"geomRateFpm\", category, squawk, \"posType\", source\nFROM \"points\"\nWHERE true\nQUALIFY row_number() OVER (PARTITION BY hex, ts ORDER BY \"flight\" NULLS LAST, \"registration\" NULLS LAST, \"typeCode\" NULLS LAST, \"lat\" NULLS LAST, \"lon\" NULLS LAST, \"altBaroFt\" NULLS LAST, \"altGeomFt\" NULLS LAST, \"onGround\" NULLS LAST, \"gsKt\" NULLS LAST, \"trackDeg\" NULLS LAST, \"baroRateFpm\" NULLS LAST, \"geomRateFpm\" NULLS LAST, \"category\" NULLS LAST, \"squawk\" NULLS LAST, \"posType\" NULLS LAST, \"source\" NULLS LAST) = 1\nORDER BY hex, ts",
    "window": "SELECT CAST(epoch_ms(ts) AS TIMESTAMP_MS) AS ts, hex, flight, registration, \"typeCode\", CAST(lat AS DECIMAL(7, 5)) AS lat, CAST(lon AS DECIMAL(8, 5)) AS lon, CAST(round(\"altBaroFt\") AS INTEGER) AS \"altBaroFt\", CAST(round(\"altGeomFt\") AS INTEGER) AS \"altGeomFt\", \"onGround\", round(\"gsKt\", 1) AS \"gsKt\", round(\"trackDeg\", 1) % 360 AS \"trackDeg\", CAST(round(\"baroRateFpm\") AS INTEGER) AS \"baroRateFpm\", CAST(round(\"geomRateFpm\") AS INTEGER) AS \"geomRateFpm\", category, squawk, \"posType\", source\nFROM \"points\"\nWHERE ts >= 1794266820000 AND ts < 1794268680000\nQUALIFY row_number() OVER (PARTITION BY hex, ts ORDER BY \"flight\" NULLS LAST, \"registration\" NULLS LAST, \"typeCode\" NULLS LAST, \"lat\" NULLS LAST, \"lon\" NULLS LAST, \"altBaroFt\" NULLS LAST, \"altGeomFt\" NULLS LAST, \"onGround\" NULLS LAST, \"gsKt\" NULLS LAST, \"trackDeg\" NULLS LAST, \"baroRateFpm\" NULLS LAST, \"geomRateFpm\" NULLS LAST, \"category\" NULLS LAST, \"squawk\" NULLS LAST, \"posType\" NULLS LAST, \"source\" NULLS LAST) = 1\nORDER BY hex, ts"

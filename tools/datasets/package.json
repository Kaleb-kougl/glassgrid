{
  "name": "@glassgrid/datasets",
  "version": "0.1.0",
  "private": true,
  "description": "Reproducible, pinned benchmark CSVs for Glassgrid (NYC TLC taxi + seeded synthetic) and the web demo's synthetic sample datasets.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "taxi": "tsx src/taxi.ts",
    "synthetic": "tsx src/synthetic.ts",
    "verify": "tsx src/verify.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "samples": "tsx src/samples.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "@glassgrid/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}

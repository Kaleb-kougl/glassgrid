@@ -80,6 +82,52 @@ jobs:
             apps/web/test-results/
           if-no-files-found: ignore
 
+  # The web demo in Firefox and WebKit (docs/live-flights.md, "Cross-browser"): the flights specs (the recorded traffic,
+  # the list view and axe, the live states against the stand-in relay) and the smoke test. New in L5 and not yet run on
+  # GitHub, so it may fail without blocking a merge until its first green run; then drop continue-on-error.
+  web-browsers:
+    name: Web E2E (Firefox, WebKit)
+    needs: checks
+    runs-on: ubuntu-latest
+    timeout-minutes: 40
+    continue-on-error: true
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: pnpm/action-setup@ea17c68df8912ef543352723c149a84f56e3d413 # v6.1.0
+      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
+        with:
+          node-version-file: .nvmrc
+          cache: pnpm
+      - run: pnpm install --frozen-lockfile
+      # Firefox and WebKit are cached like Chromium in the checks job (their own key); their OS packages are not.
+      - name: Playwright version
+        id: playwright
+        run: echo "version=$(pnpm --filter @glassgrid/web exec playwright --version | awk '{print $2}')" >> "$GITHUB_OUTPUT"
+      - name: Cache Playwright's Firefox and WebKit
+        id: playwright-cache
+        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: ~/.cache/ms-playwright
+          key: playwright-firefox-webkit-${{ runner.os }}-${{ steps.playwright.outputs.version }}
+      - name: Install Firefox and WebKit
+        if: steps.playwright-cache.outputs.cache-hit != 'true'
+        run: pnpm --filter @glassgrid/web exec playwright install --with-deps firefox webkit
+      - name: Install Firefox's and WebKit's system dependencies
+        if: steps.playwright-cache.outputs.cache-hit == 'true'
+        run: pnpm --filter @glassgrid/web exec playwright install-deps firefox webkit
+      - run: pnpm --filter @glassgrid/web build
+      - name: Web E2E in Firefox and WebKit
+        run: pnpm --filter @glassgrid/web exec playwright test e2e/flights.spec.ts e2e/flights-a11y.spec.ts e2e/flights-live.spec.ts e2e/smoke.spec.ts
+        env:
+          GLASSGRID_E2E_BROWSERS: firefox,webkit
+      - name: Upload browser test results
+        if: failure()
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: web-browsers-test-results
+          path: apps/web/test-results/
+          if-no-files-found: ignore
+
   e2e:
     name: Build + E2E (${{ matrix.os }})
     needs: checks
